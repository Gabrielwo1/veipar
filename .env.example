# ── Z-API ────────────────────────────────────────────────────
# Painel Z-API → Instâncias → sua instância
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# Painel Z-API → Segurança → Token de segurança da conta (header Client-Token)
ZAPI_CLIENT_TOKEN=
# Se houver mais de uma instância (ex.: uma por unidade), liste todas aqui separadas por vírgula.
# Os avisos ao gerente saem sempre pela ZAPI_INSTANCE_ID.
ZAPI_ALLOWED_INSTANCES=
# String longa e aleatória. Vai na URL do webhook: /api/webhook?secret=<valor>
# Gere com: openssl rand -hex 24
WEBHOOK_SECRET=

# ── Aviso ao gerente ─────────────────────────────────────────
# Um ou mais números, só dígitos com DDI, separados por vírgula. Ex.: 5546999990000,5542999990000
MANAGER_PHONES=
# Grupos que também recebem o aviso (ex.: grupo da equipe de atendimento). IDs separados por vírgula.
# Descubra o ID em GET /api/groups (com o header Authorization: Bearer <DASHBOARD_PASSWORD>). Ex.: 120363000000000000-group
NOTIFY_GROUP_IDS=
# Se o mesmo número voltar a chamar depois de X horas sem conversa, avisa de novo (0 = só no 1º contato)
NOTIFY_RETURN_AFTER_HOURS=24
# Nome de cada número da empresa, no formato telefone:Nome, separados por vírgula
# Ex.: 554130000000:Loja Centro,554130000001:Loja Norte
LINE_LABELS=

# ── Banco (Supabase) ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Painel ───────────────────────────────────────────────────
DASHBOARD_PASSWORD=

# ── Atendente de IA ─────────────────────────────────────────
# Chave da API da OpenAI (platform.openai.com → API keys). Sem ela, a IA fica desligada.
OPENAI_API_KEY=
# Modelo da OpenAI (padrão gpt-5.5; gpt-5.4-mini é mais barato)
AI_MODEL=gpt-5.5
# false desliga a IA em todas as conversas (o painel continua funcionando)
AI_ENABLED=true
# Segundos de espera antes de responder, para juntar mensagens seguidas do cliente
AI_DEBOUNCE_SECONDS=8

# LGPD: mensagens podem conter dados pessoais. O texto é necessário para as conversas no painel e para a IA.
# false = não grava o texto (painel de conversas e IA ficam sem contexto).
STORE_MESSAGE_TEXT=true
TIMEZONE=America/Sao_Paulo
